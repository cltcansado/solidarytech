# Copie para terraform.tfvars e preencha (NUNCA commitar terraform.tfvars com segredos reais -
# já está no .gitignore). Segredos (senha do RDS) devem ir via TF_VAR_rds_master_password,
# não neste arquivo.

aws_region   = "us-east-1"
dr_region    = "us-west-2"
cluster_name = "solidarytech-eks"

# AWS Academy: pegar em IAM > Roles > LabRole na aba "Details" do voclabs.
lab_role_arn = "arn:aws:iam::<ACCOUNT_ID>:role/LabRole"

gitops_repo_url        = "https://github.com/cltcansado/solidarytech-gitops.git"
gitops_target_revision = "main"

velero_bucket_suffix = "<algo-unico-ex-conta-aws-ou-rm-do-grupo>"

# No primeiro apply, o cluster EKS ainda não existe -> providers kubernetes/helm falhariam
# ao tentar autenticar. Rode a primeira vez com false, depois mude para true:
enable_argocd_bootstrap = false
